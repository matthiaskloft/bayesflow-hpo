{
  "permissions": {
    "allow": [
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(python3:*)",
      "Bash(KERAS_BACKEND=torch python3:*)",
      "Bash(KERAS_BACKEND=torch python:*)",
      "Bash(pip:*)",
      "Bash(ruff:*)",
      "Bash(which:*)",
      "Bash(echo:*)",
      "Bash(diff:*)",
      "Bash(ls:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Read(*)",
      "Write(*)",
      "Edit(*)",
      "Glob(*)",
      "Grep(*)",
      "Bash(git fetch:*)",
      "WebFetch(domain:api.github.com)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "excludedCommands": ["git", "gh"]
  }
}
