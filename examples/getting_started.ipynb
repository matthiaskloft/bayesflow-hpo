    "    initial_learning_rate=float(config[\"initial_lr\"]),  # best_config() returns str\n",
    "    decay_steps=epochs * batches_per_epoch,\n",
    ")\n",
    "approximator.compile(optimizer=keras.optimizers.Adam(learning_rate=lr_schedule))\n",
    "\n",
    "# Retrain with a larger budget than HPO used (num_batches for BayesFlow 2.0.8+)\n",
    "approximator.fit(\n",
    "    simulator=simulator,\n",
    "    epochs=epochs,\n",
    "    num_batches=batches_per_epoch,\n",
    "    batch_size=int(config.get(\"batch_size\", 256)),\n",
    ")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "28wf1875bnm",
   "source": "### 4.4 Save the Final Model\n\n`save_workflow_with_metadata()` persists the trained approximator as a `.keras` file alongside a `.json` metadata sidecar that records the hyperparameters, library versions, and any extra info you provide. This makes the model fully reproducible.",
   "metadata": {},
   "outputs": []
  },
  {
   "cell_type": "code",
   "id": "0edg99b7likf",
   "source": "metadata = hpo.get_workflow_metadata(\n    config=config,\n    model_type=\"ContinuousApproximator\",\n    extra={\"retrained_epochs\": epochs, \"retrained_batches_per_epoch\": batches_per_epoch},\n)\nmodel_path = hpo.save_workflow_with_metadata(approximator, \"quickstart_model\", metadata)\nprint(f\"Model saved to {model_path}\")\nprint(f\"Metadata saved to {model_path.with_suffix('.json')}\")",
   "metadata": {},
